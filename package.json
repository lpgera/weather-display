{
  "name": "weather-display",
  "version": "1.0.0",
  "description": "A little Node app which displays current weather data on a tiny SSD1306 OLED display",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": "^25.0.0",
    "npm": ">11.0.0"
  },
  "volta": {
    "node": "25.2.1"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env index.js",
    "dev": "node --watch --env-file=.env index.js"
  },
  "author": "lpgera",
  "license": "MIT",
  "dependencies": {
    "express": "^5.1.0",
    "jimp": "^1.6.0"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.6.2"
  },
  "lint-staged": {
    "*.{js,jsx,md,json,yml}": "prettier --write"
  }
}
